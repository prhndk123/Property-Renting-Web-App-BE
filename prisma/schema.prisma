generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ──────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  TENANT
}

enum ReservationStatus {
  WAITING_PAYMENT
  WAITING_CONFIRMATION
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum PriceType {
  NOMINAL
  PERCENTAGE
}

enum PaymentMethod {
  MANUAL_TRANSFER
  PAYMENT_GATEWAY
}

// ─── MODELS ─────────────────────────────────────────────────────────────────────

model User {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  email          String    @unique
  password       String?
  role           UserRole?
  phone          String?
  businessName   String?
  provider       String    @default("email") // "email" | "google"
  profilePicture String?
  isVerified     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
  refreshToken       RefreshToken?
  categories         PropertyCategory[] @relation("TenantCategories")
  properties         Property[] // Properties owned by tenant
  reservations       Reservation[] // Reservations made by user
  reviews            Review[]
  reviewReplies      ReviewReply[] // Replies by tenant

  @@index([role])
  @@map("users")
}

model EmailVerification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("email_verifications")
}

model PasswordReset {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_resets")
}

model PropertyCategory {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  createdAt DateTime @default(now())

  // Relations
  tenant     User       @relation("TenantCategories", fields: [tenantId], references: [id], onDelete: Cascade)
  properties Property[]

  @@unique([name, tenantId])
  @@index([tenantId])
  @@map("property_categories")
}

model Property {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  categoryId  String   @db.Uuid
  name        String
  slug        String   @unique @default(uuid())
  description String   @db.Text
  address     String
  city        String
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tenant       User             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category     PropertyCategory @relation(fields: [categoryId], references: [id])
  images       PropertyImage[]
  rooms        Room[]
  reservations Reservation[]
  reviews      Review[]

  @@index([tenantId])
  @@index([categoryId])
  @@index([city])
  @@map("properties")
}

model PropertyImage {
  id         String @id @default(uuid()) @db.Uuid
  propertyId String @db.Uuid
  imageUrl   String

  // Relations
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_images")
}

model Room {
  id          String   @id @default(uuid()) @db.Uuid
  propertyId  String   @db.Uuid
  name        String
  description String   @db.Text
  capacity    Int
  basePrice   Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  // Relations
  property         Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  images           RoomImage[]
  availability     RoomAvailability[]
  peakSeasonRates  PeakSeasonRate[]
  reservationRooms ReservationRoom[]

  @@index([propertyId])
  @@map("rooms")
}

model RoomImage {
  id       String @id @default(uuid()) @db.Uuid
  roomId   String @db.Uuid
  imageUrl String

  // Relations
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@map("room_images")
}

model RoomAvailability {
  id          String   @id @default(uuid()) @db.Uuid
  roomId      String   @db.Uuid
  date        DateTime @db.Date
  isAvailable Boolean  @default(true)

  // Relations
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, date])
  @@index([roomId])
  @@index([date])
  @@map("room_availability")
}

model PeakSeasonRate {
  id        String    @id @default(uuid()) @db.Uuid
  roomId    String    @db.Uuid
  startDate DateTime  @db.Date
  endDate   DateTime  @db.Date
  priceType PriceType
  value     Decimal   @db.Decimal(12, 2)

  // Relations
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([startDate, endDate])
  @@map("peak_season_rates")
}

model Reservation {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String            @db.Uuid
  propertyId   String            @db.Uuid
  checkinDate  DateTime          @db.Date
  checkoutDate DateTime          @db.Date
  totalPrice   Decimal           @db.Decimal(12, 2)
  status       ReservationStatus @default(WAITING_PAYMENT)
  createdAt    DateTime          @default(now())

  // Relations
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  property         Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservationRooms ReservationRoom[]
  payment          Payment?
  review           Review?

  @@index([userId])
  @@index([propertyId])
  @@index([status])
  @@index([checkinDate, checkoutDate])
  @@map("reservations")
}

model ReservationRoom {
  id            String  @id @default(uuid()) @db.Uuid
  reservationId String  @db.Uuid
  roomId        String  @db.Uuid
  price         Decimal @db.Decimal(12, 2)
  nights        Int

  // Relations
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  room        Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([reservationId, roomId])
  @@index([reservationId])
  @@index([roomId])
  @@map("reservation_rooms")
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  reservationId String        @unique @db.Uuid
  paymentMethod PaymentMethod
  paymentProof  String?
  paymentStatus PaymentStatus @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([paymentStatus])
  @@map("payments")
}

model Review {
  id            String   @id @default(uuid()) @db.Uuid
  reservationId String   @unique @db.Uuid
  propertyId    String   @db.Uuid
  userId        String   @db.Uuid
  rating        Int // 1-5
  comment       String?  @db.Text
  createdAt     DateTime @default(now())

  // Relations
  reservation Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reply       ReviewReply?

  @@index([propertyId])
  @@index([userId])
  @@map("reviews")
}

model ReviewReply {
  id        String   @id @default(uuid()) @db.Uuid
  reviewId  String   @unique @db.Uuid
  tenantId  String   @db.Uuid
  reply     String   @db.Text
  createdAt DateTime @default(now())

  // Relations
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  tenant User   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([tenantId])
  @@map("review_replies")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @unique @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiredAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("refresh_tokens")
}
