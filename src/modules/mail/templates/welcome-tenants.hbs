<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Welcome to Rentivo Partnership!</title>
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      line-height: 1.6;
      color: #1a1a1a;
      background-color: #f5f5f5;
      margin: 0;
      padding: 20px;
    }
    .container {
      max-width: 600px;
      margin: 0 auto;
      background-color: #ffffff;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }
    .header {
      background: linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%);
      color: white;
      padding: 40px 24px;
      text-align: center;
    }
    .header-icon { font-size: 48px; margin-bottom: 16px; }
    .header h1 { margin: 0; font-size: 28px; font-weight: 700; }
    .header p { margin: 8px 0 0; font-size: 16px; opacity: 0.9; }
    .content { padding: 32px 24px; }
    .greeting { font-size: 18px; font-weight: 600; margin-bottom: 16px; color: #1a1a1a; }
    .message { color: #4a4a4a; margin-bottom: 24px; }
    .features-box {
      background-color: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      padding: 20px;
      margin-bottom: 24px;
    }
    .feature-item { margin-bottom: 12px; }
    .feature-item:last-child { margin-bottom: 0; }
    .feature-icon {
      display: inline-block;
      width: 24px;
      margin-right: 12px;
      font-size: 16px;
      vertical-align: top;
    }
    .feature-text {
      display: inline-block;
      color: #4a4a4a;
      font-size: 14px;
      vertical-align: top;
      max-width: 85%;
    }
    .button-container { text-align: center; margin: 32px 0; }
    .cta-button {
      display: inline-block;
      background: linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%);
      color: white !important;
      text-decoration: none;
      padding: 14px 32px;
      border-radius: 8px;
      font-weight: 600;
      font-size: 16px;
      box-shadow: 0 4px 12px rgba(79, 70, 229, 0.4);
    }
    .subtext { color: #6b7280; font-size: 13px; margin-top: 20px; }
    .footer {
      background-color: #f8fafc;
      padding: 24px;
      text-align: center;
      border-top: 1px solid #e2e8f0;
    }
    .footer p { margin: 0 0 8px 0; font-size: 13px; color: #6b7280; }
    .brand { font-weight: 600; color: #4f46e5; }
  </style>
</head>
<body>
  <div class="container">
    <!-- Header -->
    <div class="header">
      <div class="header-icon">🏢</div>
      <h1>Welcome to Rentivo Tenants!</h1>
      <p>Grow your property business with us</p>
    </div>

    <!-- Content -->
    <div class="content">
      <p class="greeting">Hello {{name}}! 👋</p>
      <p class="message">
        Welcome to the Rentivo Tenant Network! We're excited to partner with you
        to showcase your amazing properties to millions of potential guests around the world.
      </p>

      <!-- Features -->
      <div class="features-box">
        <div class="feature-item">
          <span class="feature-icon">📈</span>
          <span class="feature-text">Maximize your occupancy and revenue</span>
        </div>
        <div class="feature-item">
          <span class="feature-icon">🛎️</span>
          <span class="feature-text">Manage bookings, availability, and guests with ease</span>
        </div>
        <div class="feature-item">
          <span class="feature-icon">💳</span>
          <span class="feature-text">Receive secure and timely payments</span>
        </div>
      </div>

      <div class="button-container">
        <a href="{{dashboardLink}}" class="cta-button">Go to Tenant Dashboard</a>
      </div>
    </div>

    <!-- Footer -->
    <div class="footer">
      <p>Thank you for choosing Rentivo.</p>
      <p>&copy; 2026 <span class="brand">Rentivo App</span>. All rights reserved.</p>
    </div>
  </div>
</body>
</html>